{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Frontend: Dev",
            "type": "npm",
            "script": "dev",
            "path": "frontend",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "fileLocation": "relative",
                "pattern": {
                    "regexp": "^.*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*VITE.*",
                    "endsPattern": ".*ready in.*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "group": "Frontend"
            }
        }
    ]
}
